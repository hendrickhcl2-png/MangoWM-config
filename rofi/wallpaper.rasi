* {
    bg:          #201B14f0;
    fg:          #d3d3ce;
    accent:      #c9b890;
    sel-bg:      #AC925988;
    sel-fg:      #fbf1c7;
    border-r:    14px;
}

window {
    background-color: @bg;
    border-radius:    @border-r;
    border:           2px solid;
    border-color:     @accent;
    width:            960px;
    height:           620px;
    padding:          20px;
}

mainbox {
    spacing:  14px;
    children: ["inputbar", "listview"];
    background-color: transparent;
}

inputbar {
    children:         ["prompt", "entry"];
    spacing:          10px;
    padding:          6px 14px;
    background-color: #00000033;
    border-radius:    8px;
    text-color:       @fg;
}

prompt {
    text-color: @accent;
    font:       "Maple Mono NF CN bold 14";
}

entry {
    text-color:        @fg;
    placeholder:       "search...";
    placeholder-color: #666666;
    font:              "Maple Mono NF CN 14";
}

listview {
    columns:      3;
    lines:        2;
    spacing:      12px;
    scrollbar:    false;
    fixed-height: false;
    background-color: transparent;
}

element {
    background-color: #00000000;
    border-radius:    10px;
    padding:          8px;
    orientation:      vertical;
    spacing:          6px;
    cursor:           pointer;
}

element normal.normal {
    background-color: #00000022;
}

element selected.normal {
    background-color: @sel-bg;
    border:           2px solid;
    border-color:     @accent;
}

element-icon {
    size:         230px;
    border-radius: 8px;
    background-color: transparent;
}

element-text {
    text-color:       @fg;
    font:             "Maple Mono NF CN 11";
    horizontal-align: 0.5;
    background-color: transparent;
}

element selected.normal element-text {
    text-color: @sel-fg;
}
