// -*- mode: jsonc -*-
{
    "layer": "top",
    "height": 36,
    "spacing": 0,
    "modules-left": [
        "ext/workspaces",
        "wlr/taskbar",
        "dwl/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/gpu",
        "cpu",
        "memory",
        "temperature",
        "disk",
        "battery",
        "network",
        "backlight",
        "custom/nightlight",
        "wireplumber",
        "tray",
        "custom/power"
    ],

    "ext/workspaces": {
        "format": "{name}",
        "ignore-hidden": true,
        "on-click": "activate",
        "on-click-right": "deactivate",
        "on-scroll-up": "mmsg -d viewtoleft_have_client",
        "on-scroll-down": "mmsg -d viewtoright_have_client",
        "sort-by-id": true
    },

    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 18,
        "all-outputs": false,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-right": "close",
        "ignore-list": ["Rofi", "wofi"]
    },

    "dwl/window": {
        "format": "{title}",
        "max-length": 40
    },

    "network": {
        "interval": 5,
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 {ifname}",
        "format-disconnected": "󰤭 disconnected",
        "tooltip-format-wifi": "{signalStrength}%  {ipaddr}/{cidr}",
        "tooltip-format-ethernet": "{ipaddr}/{cidr}",
        "on-click": "foot -e nmtui"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 6
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%a, %b %d}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "cpu": {
        "interval": 3,
        "format": "󰘚 {load}%"
    },

    "memory": {
        "interval": 5,
        "format": "󰍛 {}%"
    },

    "temperature": {
        "critical-threshold": 90,
        "format": "{icon} {temperatureC}°",
        "format-icons": ["", "", ""],
        "tooltip-format": "{temperatureF}°F"
    },

    "custom/gpu": {
        "exec": "nvidia-smi --query-gpu=utilization.gpu,memory.used --format=csv,noheader,nounits | awk -F', ' '{printf \"󰢮 %d%% %dM\", $1, $2}'",
        "interval": 3,
        "format": "{}",
        "tooltip-format": "GPU"
    },

    "disk": {
        "interval": 30,
        "format": "󰋊 {percentage_used}%",
        "path": "/",
        "tooltip-format": "{used} / {total}"
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"]
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "tooltip": false,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-",
        "format-icons": ["󰕿", "󰖀", "󰕾"]
    },

    "custom/nightlight": {
        "format": "{}",
        "exec": "/home/hendrick/.config/mango/scripts/nightlight.sh status",
        "interval": 3,
        "on-click": "/home/hendrick/.config/mango/scripts/nightlight.sh toggle",
        "on-scroll-up": "/home/hendrick/.config/mango/scripts/nightlight.sh warmer",
        "on-scroll-down": "/home/hendrick/.config/mango/scripts/nightlight.sh cooler",
        "tooltip": false
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "wlogout -C ~/.config/mango/wlogout/style.css -l ~/.config/mango/wlogout/layout -b 6 --protocol layer-shell",
        "on-click-right": "sleep 0.1s && swaync-client -t -sw"
    }
}
